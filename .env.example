# Copy this file to .env and fill it in. Never commit .env.

# --- Database (Supabase) -------------------------------------------------------
# Supabase dashboard > Project Settings > Database > Connection string > URI.
# Use the "Session pooler" or "Direct connection" string. If your password has
# special characters (@ : / ?), URL-encode them.
DATABASE_URL="postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# --- Security --------------------------------------------------------------------
# Signs login cookies. Required. Make it long and random, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# How many reverse proxies sit in front of the app (Cloud Run, Render, Railway = 1).
# Leave 0 when running on your own computer.
TRUST_PROXY=0

# Password given to students created by the Excel import. They must change it at first login.
INITIAL_STUDENT_PASSWORD="Password@123"

# --- AI question generator (optional) --------------------------------------------
# Pick one. With no key the generator returns a built-in set of sample questions.
# AI_PROVIDER=deepseek   # deepseek | gemini | mock   (auto-detected from the keys below)
DEEPSEEK_API_KEY=""
# DEEPSEEK_MODEL="deepseek-chat"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL="gemini-4-hydrogen"

# AI Studio sets this automatically at runtime.
APP_URL="MY_APP_URL"
